{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure x64",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "vs2022-x64"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build x64 Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "x64-debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure x64",
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
